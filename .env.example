# 웹 포트와 기본 시간대 (LAN 접근을 열려면 PHOTO_SAVER_LAN_IP에 해당 인터페이스 IP 지정)
PHOTO_SAVER_PORT=8888
PHOTO_SAVER_LAN_IP=
PHOTO_SAVER_TIMEZONE=Asia/Seoul

# 로컬 영상 디렉터리. 상대 경로는 프로젝트 디렉터리를 기준으로 한다.
PHOTO_LIBRARY_ROOT=.
INCOMING_DIR=incoming
MANAGED_DIR=managed

# 스토리지의 SSH 계정명
PHOTO_SAVER_STORAGE_USER=

# Optional OMV startup via unchanged existing Home Assistant script.
# Set URL/token, then recreate api and worker (restart alone does not load env).
# Docker에서는 .local(mDNS) 이름이 해석되지 않을 수 있습니다. HA의 LAN IP를 권장합니다.
# 호스트에서 실행 중인 HA에는 host.docker.internal을 사용할 수 있습니다.
PHOTO_SAVER_HA_URL=
PHOTO_SAVER_HA_TOKEN=
PHOTO_SAVER_HA_SCRIPT_ENTITY=script.wake_omv
PHOTO_SAVER_HA_RUNNING_ENTITY=binary_sensor.omv_running
# 0: 장기 안정 상태 허용. 양수: 마지막 보고의 최대 나이(초)를 선택 적용.
PHOTO_SAVER_HA_STALE_SECONDS=0
PHOTO_SAVER_WAKE_TIMEOUT_SECONDS=180
